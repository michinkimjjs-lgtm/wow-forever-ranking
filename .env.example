# 이 배포가 사용하는 데이터 영역: mock | beta | live (필수)
APP_DATA_ENVIRONMENT=mock

# mock 데이터는 반드시 전용 데이터베이스를 사용한다.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/forever_rank_mock

# canonical / Open Graph URL 생성에 사용
SITE_URL=http://localhost:3000

# 캐릭터 제출 (docs/SUBMISSION-SYSTEM.md, 기본 꺼짐)
# 관리자 API (Bearer 토큰)
# FEATURE_CHARACTER_SUBMISSIONS=on
# 관리자 토큰: 관리자 API와 /admin 로그인에 사용
# SUBMISSIONS_ADMIN_TOKEN=32자-이상의-임의-문자열
# 공개 제출 화면(/submit). SUBMISSION_SECRET이 있어야 켜진다.
# FEATURE_PUBLIC_SUBMISSIONS=on
# 화면 보안 토큰·요청 제한 일시 식별값·관리자 로그인 서명용 비밀값 (저장소에 넣지 않는다)
# SUBMISSION_SECRET=32자-이상의-임의-문자열

# Blizzard Provider (docs/BLIZZARD-API-INTEGRATION-PLAN.md)
# WoW: Forever 웹 API는 아직 확인되지 않았다. 공식 문서와 약관을 확인하기 전에는 설정하지 않는다.
# URL과 namespace에는 기본값이 없다. 공식 문서로 확인한 값만 넣는다.
# BLIZZARD_API_ENABLED=on
# BLIZZARD_REGION=
# BLIZZARD_API_BASE_URL=
# BLIZZARD_OAUTH_TOKEN_URL=
# BLIZZARD_CLIENT_ID=
# BLIZZARD_CLIENT_SECRET=
# BLIZZARD_API_NAMESPACES=
# BLIZZARD_API_LOCALE=
# BLIZZARD_API_TIMEOUT_MS=10000
